BACKEND_SERVER_PORT=5000
APP_TIMEZONE=Asia/Ho_Chi_Minh
MONGODB_URI=mongodb://127.0.0.1:27018/audiobay?directConnection=true

# MongoDB URI must point to a replica set (including local development).
FRONTEND_URL=http://localhost:3000
EMAIL_TOKEN_KEY_ID=v1
# Generate 32 random bytes as 64 hex characters; never commit the real key.
EMAIL_TOKEN_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

