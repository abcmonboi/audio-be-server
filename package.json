{
  "name": "audio-be-server",
  "version": "1.0.0",
  "description": "build back end server with nodejs by express library",
  "license": "ISC",
  "author": "ab",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.mjs",
    "dev": "tsx watch server.ts",
    "worker:email": "tsx src/workers/email-verification.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.10.1",
    "nodemailer": "^10.0.10",
    "slugify": "^1.6.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
